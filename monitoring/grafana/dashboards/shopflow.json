{
  "uid": "shopflow-services",
  "title": "ShopFlow Services",
  "tags": ["shopflow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime (up)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(up{job=~\"products|orders\"})", "legendFormat": "services up" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (job)", "legendFormat": "{{ job }}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (job) / clamp_min(sum(rate(http_requests_total[5m])) by (job), 0.0001)", "legendFormat": "{{ job }}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latency (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, job))", "legendFormat": "{{ job }}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Processed orders (Redis counter)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "sum(rate(worker_orders_processed_total[5m]))", "legendFormat": "orders/sec" }
      ]
    }
  ]
}