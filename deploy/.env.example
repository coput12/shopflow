# Корневой конфиг приложений
# Копируй в .env (на VM или в Windows) и подставляй свои значения.
# Никогда не коммить реальные .env в git!

# --- Приложения ---
PRODUCTS_DATABASE_URL=postgresql://shopflow:shopflow@postgres:5432/shopflow
PRODUCTS_REDIS_URL=redis://redis:6379/0

ORDERS_DATABASE_URL=postgresql://shopflow:shopflow@postgres:5432/shopflow_orders
ORDERS_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

WORKER_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
WORKER_REDIS_URL=redis://redis:6379/1

# --- Инфраструктура ---
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=shopflow
POSTGRES_DB=shopflow

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- Образы (Docker Hub / registry) ---
IMAGE_REGISTRY=ghcr.io
IMAGE_ORG=your_github_username
IMAGE_TAG=latest